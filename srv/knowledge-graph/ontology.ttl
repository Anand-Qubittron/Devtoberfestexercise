@prefix pc:   <https://devtoberfest.local/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Ontology for the Devtoberfest Process Center and my learning journey.
# It describes business concepts and their relationships only — the data (RDF)
# is generated from the CAP database and an external feed by rdf.js.
#
# rdfs:label is the preferred name, skos:altLabel holds synonyms. Both are what the
# question understanding (nlq.js) recognises — the ontology is the vocabulary.

<https://devtoberfest.local/ontology> a owl:Ontology ;
  rdfs:label "Devtoberfest Process Center ontology" ;
  owl:versionInfo "2.0" .

# ─── Purchasing (SAP) ────────────────────────────────────────────────────────
pc:Supplier        a owl:Class ; rdfs:label "Supplier" ;         skos:altLabel "vendor" .
pc:Material        a owl:Class ; rdfs:label "Material" ;         skos:altLabel "product" .
pc:PurchaseRequest a owl:Class ; rdfs:label "Purchase request" ; skos:altLabel "PR", "requisition" .
pc:Country         a owl:Class ; rdfs:label "Country" .

pc:suppliedBy   a owl:ObjectProperty ; rdfs:label "supplied by" ;  skos:altLabel "supplies", "supply", "delivers" ;
  rdfs:domain pc:Material ; rdfs:range pc:Supplier .
pc:locatedIn    a owl:ObjectProperty ; rdfs:label "located in" ;   rdfs:domain pc:Supplier ;        rdfs:range pc:Country .
pc:forMaterial  a owl:ObjectProperty ; rdfs:label "for material" ; rdfs:domain pc:PurchaseRequest ; rdfs:range pc:Material .
pc:fromSupplier a owl:ObjectProperty ; rdfs:label "from supplier" ; rdfs:domain pc:PurchaseRequest ; rdfs:range pc:Supplier .

pc:blocked      a owl:DatatypeProperty ; rdfs:label "blocked" ;     rdfs:domain pc:Supplier ;  rdfs:range xsd:boolean .
pc:dunsNumber   a owl:DatatypeProperty ; rdfs:label "DUNS number" ; rdfs:range xsd:string ;
  rdfs:comment "Global company identifier — used to match SAP suppliers with external data" .
pc:price        a owl:DatatypeProperty ; rdfs:label "price" ;       rdfs:domain pc:Material ;  rdfs:range xsd:decimal .
pc:quantity     a owl:DatatypeProperty ; rdfs:label "quantity" ;    rdfs:range xsd:integer .
pc:amount       a owl:DatatypeProperty ; rdfs:label "amount" ;      skos:altLabel "value", "spend", "volume" ;
  rdfs:domain pc:PurchaseRequest ; rdfs:range xsd:decimal .

# ─── Excel uploads and processing (Process Center) ───────────────────────────
pc:Upload        a owl:Class ; rdfs:label "Excel upload" ; skos:altLabel "upload", "batch" .
pc:UploadRow     a owl:Class ; rdfs:label "Upload row" ;   skos:altLabel "row", "line" .
pc:User          a owl:Class ; rdfs:label "User" ;         skos:altLabel "person", "people", "uploader" .
pc:Process       a owl:Class ; rdfs:label "Process" ;      skos:altLabel "process instance", "job" .
pc:Lock          a owl:Class ; rdfs:label "Lock" ;         skos:altLabel "object lock" .
pc:ProcessStatus a owl:Class ; rdfs:label "Process status" ; skos:altLabel "status" .
pc:MissingObject a owl:Class ; rdfs:label "Missing object" ; skos:altLabel "missing" ;
  rdfs:comment "Something a parked process waits for that does not exist yet, e.g. a material number nobody has created" .

pc:hasRow       a owl:ObjectProperty ; rdfs:label "has row" ;      rdfs:domain pc:Upload ;    rdfs:range pc:UploadRow .
pc:uploadedBy   a owl:ObjectProperty ; rdfs:label "uploaded by" ;  skos:altLabel "uploaded" ;
  rdfs:domain pc:Upload ; rdfs:range pc:User .
pc:orders       a owl:ObjectProperty ; rdfs:label "orders" ;       skos:altLabel "ordered", "ordering" ;
  rdfs:domain pc:UploadRow ; rdfs:range pc:Material .
pc:resultedIn   a owl:ObjectProperty ; rdfs:label "resulted in" ;  rdfs:domain pc:UploadRow ; rdfs:range pc:PurchaseRequest .
pc:processedBy  a owl:ObjectProperty ; rdfs:label "processed by" ; rdfs:domain pc:UploadRow ; rdfs:range pc:Process .
pc:hasStatus    a owl:ObjectProperty ; rdfs:label "has status" ;   rdfs:domain pc:Process ;   rdfs:range pc:ProcessStatus .
pc:waitsFor     a owl:ObjectProperty ; rdfs:label "waits for" ;    skos:altLabel "waiting" ; rdfs:domain pc:Process ;
  rdfs:comment "A parked process resumes automatically once this object is saved" .
pc:locks        a owl:ObjectProperty ; rdfs:label "locks" ;        rdfs:domain pc:Lock .
pc:heldBy       a owl:ObjectProperty ; rdfs:label "held by" ;      rdfs:domain pc:Lock .

pc:rowNumber    a owl:DatatypeProperty ; rdfs:label "row number" ;  rdfs:domain pc:UploadRow ; rdfs:range xsd:integer .
pc:orderedMaterialNo a owl:DatatypeProperty ; rdfs:label "ordered material number" ; rdfs:domain pc:UploadRow ;
  rdfs:comment "Kept even when the material does not exist (yet)" .
pc:currentStep  a owl:DatatypeProperty ; rdfs:label "current step" ; rdfs:domain pc:Process .
pc:message      a owl:DatatypeProperty ; rdfs:label "message" .
pc:errorKind    a owl:DatatypeProperty ; rdfs:label "error kind" ; rdfs:domain pc:Process .
pc:lockMode     a owl:DatatypeProperty ; rdfs:label "lock mode" ;  rdfs:domain pc:Lock .

pc:Ready     a pc:ProcessStatus ; rdfs:label "Ready" .
pc:Running   a pc:ProcessStatus ; rdfs:label "Running" .
pc:Retrying  a pc:ProcessStatus ; rdfs:label "Retrying" .
pc:Parked    a pc:ProcessStatus ; rdfs:label "Parked" ;    skos:altLabel "stuck", "needs attention" .
pc:Failed    a pc:ProcessStatus ; rdfs:label "Failed" .
pc:Completed a pc:ProcessStatus ; rdfs:label "Completed" ; skos:altLabel "done", "finished" .
pc:Cancelled a pc:ProcessStatus ; rdfs:label "Cancelled" .

# ─── Supplier risk (external, non-SAP) ───────────────────────────────────────
pc:ExternalCompany a owl:Class ; rdfs:label "External company record" ;
  rdfs:comment "A company as known to the external risk provider" .
pc:RiskEvent       a owl:Class ; rdfs:label "Risk event" ; skos:altLabel "risk", "incident", "alert", "news" .

pc:sameEntityAs  a owl:ObjectProperty ; rdfs:label "same company as" ;
  rdfs:comment "Entity resolution: links an SAP supplier to the external record of the same company (matched by DUNS)" ;
  rdfs:domain pc:Supplier ; rdfs:range pc:ExternalCompany .
pc:hasRiskEvent  a owl:ObjectProperty ; rdfs:label "has risk event" ; rdfs:domain pc:ExternalCompany ; rdfs:range pc:RiskEvent .
pc:riskLevel     a owl:DatatypeProperty ; rdfs:label "risk level" ;    rdfs:domain pc:RiskEvent .
pc:riskCategory  a owl:DatatypeProperty ; rdfs:label "risk category" ; rdfs:domain pc:RiskEvent .
pc:headline      a owl:DatatypeProperty ; rdfs:label "headline" ;      rdfs:domain pc:RiskEvent .
pc:reportedOn    a owl:DatatypeProperty ; rdfs:label "reported on" ;   rdfs:domain pc:RiskEvent ; rdfs:range xsd:date .

# ─── Learning journey ────────────────────────────────────────────────────────
pc:Session    a owl:Class ; rdfs:label "Devtoberfest session" ; skos:altLabel "session", "talk" .
pc:Concept    a owl:Class ; rdfs:label "Concept" ;     skos:altLabel "topic" .
pc:App        a owl:Class ; rdfs:label "App" ;         skos:altLabel "application", "tile" .
pc:SourceFile a owl:Class ; rdfs:label "Source file" ; skos:altLabel "code" .

pc:teaches        a owl:ObjectProperty ; rdfs:label "teaches" ;         rdfs:domain pc:Session ; rdfs:range pc:Concept .
pc:demonstratedIn a owl:ObjectProperty ; rdfs:label "demonstrated in" ; rdfs:domain pc:Concept ; rdfs:range pc:App .
pc:implementedIn  a owl:ObjectProperty ; rdfs:label "implemented in" ;  rdfs:domain pc:Concept ; rdfs:range pc:SourceFile .
pc:track          a owl:DatatypeProperty ; rdfs:label "track" ;          rdfs:domain pc:Session .
pc:date           a owl:DatatypeProperty ; rdfs:label "date" ;           rdfs:domain pc:Session ; rdfs:range xsd:date .
pc:implementation a owl:DatatypeProperty ; rdfs:label "implementation" ; rdfs:domain pc:Concept .
